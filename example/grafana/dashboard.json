              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Circuit breaker",
      "description": "CLOSED=0, OPEN=1, HALF_OPEN=2. Latest flushed state per instance.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "staleprobe-prometheus"
      },
      "gridPos": {
        "x": 12,
