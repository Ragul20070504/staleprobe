          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "staleprobe-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Configured-hit coverage",
      "description": "Matched / all cache hits before sampling in latest interval; absent when no hits.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "staleprobe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
