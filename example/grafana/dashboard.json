              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Skipped checks and audit errors",
      "description": "Unconfigured, oversized, unsupported, cancelled and comparison/read failures.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "staleprobe-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
