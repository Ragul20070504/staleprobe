          "refId": "A",
          "expr": "sum by (pattern, result) (rate(cache_audit_checks_total{result=~\"SKIPPED.*|AUDIT_ERROR\"}[5m]))",
          "legendFormat": "{{pattern}} {{result}}",
          "datasource": {
