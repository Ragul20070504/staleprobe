{
  "name": "staleprobe",
  "version": "0.1.0",
  "description": "Observe-only cache staleness detection for Node.js. Probe your cache. Measure the truth.",
  "license": "MIT",
  "author": "Ragul20070504",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ragul20070504/staleprobe.git"
  },
  "homepage": "https://github.com/Ragul20070504/staleprobe#readme",
  "bugs": {
    "url": "https://github.com/Ragul20070504/staleprobe/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "benchmarks/results.json",
    "example/README.md",
    "example/app.mjs",
    "example/server.mjs",
    "example/telemetry.mjs",
    "example/package.json",
    "example/compose.yaml",
    "example/.env.example",
    "example/init.sql",
    "example/prometheus.yaml",
    "example/grafana"
  ],
  "keywords": [
    "cache",
    "redis",
    "observability",
    "opentelemetry",
    "staleness"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "dashboard:generate": "node scripts/generate-dashboard.mjs",
    "example:install": "npm --prefix example install",
    "example:start": "npm --prefix example start"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependencies": {
    "ioredis": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fast-check": "^4.10.2",
    "ioredis": "^5.11.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
